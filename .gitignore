# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
venv/
.venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# Datasets (never commit raw dataset files)
data/raw/*
!data/raw/.gitkeep

# Processed arrays (large binary files)
*.npy
*.npz

# Model weights / checkpoints (except small released models if needed)
models/*.h5
models/*.keras
!models/.gitkeep

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Video recordings & screencasts
*.mp4
*.avi
*.mov
*.mkv
*.webm
ehthumbs.db

# Logs
*.log
